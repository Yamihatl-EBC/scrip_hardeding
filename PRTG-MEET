function testWebhook() {
  const chatWebhook = PropertiesService.getScriptProperties().getProperty('CHAT_WEBHOOK_URL');
  const res = UrlFetchApp.fetch(chatWebhook, {
    method: 'post',
    contentType: 'application/json',
    payload: JSON.stringify({ text: 'Prueba ✅ Webhook y permisos OK' })
  });
  Logger.log('Chat webhook status: ' + res.getResponseCode());
}

function testOpenAI() {
  const apiKey = PropertiesService.getScriptProperties().getProperty('OPENAI_API_KEY');

  // /responses con text.format (JSON schema)
  const t1 = callOpenAIResponses_(apiKey, {
    model: RESPONSES_MODEL,
    input: 'Devuelve {"ok":true} estrictamente en JSON.',
    text: {
      format: {
        type: 'json_schema',
        name: 'ok',
        strict: true,
        schema: {
          type: 'object',
          properties: { ok: { type: 'boolean' } },
          required: ['ok'],
          additionalProperties: false
        }
      }
    },
    temperature: 0
  });
  Logger.log('responses → ' + t1);
}

function checkKeyMask() {
  const k = PropertiesService.getScriptProperties().getProperty('OPENAI_API_KEY');
  if (!k) { Logger.log('No hay OPENAI_API_KEY'); return; }
  Logger.log('Key en Script properties: ' + k.substring(0,3) + '...' + k.slice(-4));
}
