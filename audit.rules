# ======================================
# Reglas de auditoría de seguridad en Linux
# ======================================

# 1. Elimina todas las reglas actuales
-D

# 2. Aumenta los buffers para soportar eventos de alta carga
-b 8192

# 3. Define el tiempo de espera en ráfagas de eventos
--backlog_wait_time 60000

# 4. Configura el modo de fallo para enviar errores al syslog
-f 1
########################
# Auditoría de logs de auditoría
########################
# Monitorear el directorio de logs de audit
-w /var/log/audit/ -k auditlog

########################
# Auditoría de configuraciones de auditd
########################
# Monitorear cambios en los archivos de configuración de auditd
-w /etc/audit/ -p wa -k auditconfig
-w /etc/libaudit.conf -p wa -k auditconfig
-w /etc/audisp/ -p wa -k audispconfig

########################
# Uso de herramientas de administración de audit
########################
# Monitorear el uso de auditctl y auditd
-w /sbin/auditctl -p x -k audittools
-w /sbin/auditd -p x -k audittools

########################
# Reglas personalizadas adicionales
########################
# Monitoreo de inicio de sesión SSH
-w /var/log/secure -p wa -k ssh_logins

# Monitoreo del archivo de sudo
-w /var/log/sudo.log -p wa -k sudo_commands

# Monitoreo de permisos en todo /etc
-w /etc -p wa -k perms_modifications

# Monitoreo de modificaciones en directorios web
#-w /var/www/html -p wa -k web_perms_modifications

# Registrar todos los comandos ejecutados por root
-a always,exit -F arch=b64 -S execve -F euid=0 -k rootcmds

########################
# Archivos especiales (creación de nodos)
########################
-a exit,always -F arch=b32 -S mknod -S mknodat -k specialfiles
-a exit,always -F arch=b64 -S mknod -S mknodat -k specialfiles

########################
# Operaciones de montaje/desmontaje
########################
-a exit,always -F arch=b32 -S mount -S umount -S umount2 -k mount
-a exit,always -F arch=b64 -S mount -S umount2 -k mount

########################
# Cambios en la configuración de tiempo del sistema
########################
-a exit,always -F arch=b32 -S adjtimex -S settimeofday -S stime -S clock_settime -k time
-a exit,always -F arch=b64 -S adjtimex -S settimeofday -S clock_settime -k time
-w /etc/localtime -p wa -k localtime

########################
# Programación de tareas
########################
-w /etc/cron.allow -p wa -k cron
-w /etc/cron.deny -p wa -k cron
-w /etc/cron.d/ -p wa -k cron
-w /etc/cron.daily/ -p wa -k cron
-w /etc/cron.hourly/ -p wa -k cron
-w /etc/cron.monthly/ -p wa -k cron
-w /etc/cron.weekly/ -p wa -k cron
-w /etc/crontab -p wa -k cron
-w /var/spool/cron/crontabs/ -k cron

########################
# Bases de datos de usuarios y contraseñas
########################
-w /etc/group -p wa -k etcgroup
-w /etc/passwd -p wa -k etcpasswd
-w /etc/gshadow -k etcgroup
-w /etc/shadow -k etcpasswd
-w /etc/security/opasswd -k opasswd

########################
# Cambios al hostname
########################
-a exit,always -F arch=b32 -S sethostname -k hostname
-a exit,always -F arch=b64 -S sethostname -k hostname

########################
# Cambios al archivo `/etc/issue`
########################
-w /etc/issue -p wa -k etcissue
-w /etc/issue.net -p wa -k etcissue

########################
# Captura de fallos de acceso a archivos críticos
########################
-a exit,always -F arch=b64 -S open -F dir=/etc -F success=0 -k unauthedfileacess
-a exit,always -F arch=b64 -S open -F dir=/bin -F success=0 -k unauthedfileacess

########################
# Uso de comandos `su` y `sudo`
########################
-w /bin/su -p x -k priv_esc
-w /usr/bin/sudo -p x -k priv_esc
-w /etc/sudoers -p rw -k priv_esc
-w /var/log/sudo.log -p wa -k sudo_commands

########################
# Comandos de apagado/reinicio
########################
-w /sbin/halt -p x -k power
-w /sbin/poweroff -p x -k power
-w /sbin/reboot -p x -k power
-w /sbin/shutdown -p x -k power

########################
# Hacer la configuración inmutable
########################
-e 2
